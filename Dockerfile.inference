# Inference-ready image with Python3, pip, virtualenv, and build tools
# Supports workers that require compilation (llama-cpp-python, etc.)
#
# torch 2.11 + cu128: the minimax-h3-im-engine worker needs torch >= 2.10
# (diffusers PR #14355 imports torch.nn.functional.ScalingType, added in 2.10);
# cu128 is the LAST CUDA channel that covers the whole GPU fleet in one build
# (Turing sm_75 through Blackwell sm_120 — A4000/A5000/3090/A40/5090) with the
# SAME host-driver floor as the previous 2.7.1-cu128 image. torch 2.12 dropped
# cu128 (cu126 = no Blackwell kernels; cu130 = driver >= 580), so 2.11.0-cu128
# is the newest "runs everywhere" combination. ROLLOUT: this release serves the
# H3 pods first; other workers stay on the previous release (validated on torch
# 2.7.1) until the fleet revalidates deliberately.

FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

ARG TARGETOS
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ca-certificates \
    # Build tools for C/C++ compilation (llama-cpp-python, etc.)
    build-essential \
    cmake \
    ninja-build \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

WORKDIR /app

# Copy pre-built binary from goreleaser (platform-specific path)
COPY ${TARGETOS}/${TARGETARCH}/runqy-worker .

CMD ["./runqy-worker"]
